# Default: safe local inbox at http://localhost:8025. Copy to email.env (ignored).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Ledgerline <reminders@ledgerline.local>
# Gmail: smtp.gmail.com, port 465, secure=true, require_tls=true,
# user=your full Gmail address, password=16-character app password (no spaces).
# Set SMTP_FROM=Ledgerline <the same Gmail address>.
# Keep SMTP_LOCAL_ONLY=true until you explicitly enable real email delivery.
SMTP_LOCAL_ONLY=true
