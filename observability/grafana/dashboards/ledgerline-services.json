      "targets": [
        {
          "refId": "A",
          "expr": "go_goroutines{service=\"rates-realtime\"}",
          "legendFormat": "{{service}} {{database}} {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
